msgstr ""
"  title\n"
"    задаёт заголовок таблицы для последовательно печатаемых таблиц\n"

#. +> 19 18 17 16 15 14
#: help.c:513
msgid ""
"  tuples_only\n"
"    if set, only actual table data is shown\n"
msgstr ""
