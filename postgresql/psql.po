msgstr ""
"  PSQL_PAGER, PAGER\n"
"    имя программы внешнего постраничника\n"

#. +> 19 18 17 16 15
#: help.c:557
msgid ""
"  PSQL_WATCH_PAGER\n"
"    name of external pager program used for \\watch\n"
msgstr ""
"  PSQL_WATCH_PAGER\n"
"    имя программы внешнего постраничника для \\watch\n"

#. +> 19 18 17 16 15 14
