#. +> 19 18 17 16 15 14
#: pl_comp.c:2088 pl_exec.c:7188
#, c-format
msgid "type %s is not composite"
msgstr "тип %s не является составным"

#. +> 19 18 17
#: pl_comp.c:2124
#, c-format
msgid "could not find array type for data type %s"
msgstr "тип массива для типа данных %s не найден"

#. +> 19 18 17 16 15 14
#: pl_comp.c:2163 pl_comp.c:2212
#, c-format
msgid "unrecognized exception condition \"%s\""
msgstr "нераспознанное условие исключения \"%s\""

#. +> 17 16 15 14
#: pl_comp.c:2480
#, c-format
msgid "cannot pass more than %d argument to a function"
msgid_plural "cannot pass more than %d arguments to a function"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. +> 19 18 17 16 15 14
#: pl_exec.c:524 pl_exec.c:964 pl_exec.c:1199
msgid "during initialization of execution state"
msgstr "в процессе инициализации состояния выполнения"

#. +> 19 18 17 16 15 14
#: pl_exec.c:530
msgid "while storing call arguments into local variables"
msgstr "при сохранении аргументов вызова в локальных переменных"

#. +> 19 18 17 16 15 14
#: pl_exec.c:619 pl_exec.c:1037
msgid "during function entry"
msgstr "при входе в функцию"

#. +> 19 18 17 16 15 14
#: pl_exec.c:642
#, c-format
msgid "control reached end of function without RETURN"
msgstr "конец функции достигнут без RETURN"

#. +> 19 18 17 16 15 14
#: pl_exec.c:648
msgid "while casting return value to function's return type"
msgstr "при приведении возвращаемого значения к типу результата функции"

#. +> 19 18 17 16 15 14
#: pl_exec.c:660 pl_exec.c:3714
#, c-format
msgid "set-valued function called in context that cannot accept a set"
msgstr ""
"функция, возвращающая множество, вызвана в контексте, где ему нет места"

#. +> 19 18 17 16 15
#: pl_exec.c:665 pl_exec.c:3720
#, c-format
msgid "materialize mode required, but it is not allowed in this context"
msgstr "требуется режим материализации, но он недопустим в этом контексте"

#. +> 19 18 17 16 15 14
#: pl_exec.c:792 pl_exec.c:1063 pl_exec.c:1221
msgid "during function exit"
msgstr "при выходе из функции"

#. +> 19 18 17 16 15 14
#: pl_exec.c:847 pl_exec.c:911 pl_exec.c:3512
msgid "returned record type does not match expected record type"
msgstr "возвращаемый тип записи не соответствует ожидаемому"

#. +> 19 18 17 16 15 14
#: pl_exec.c:1060 pl_exec.c:1218
#, c-format
msgid "control reached end of trigger procedure without RETURN"
msgstr "конец триггерной процедуры достигнут без RETURN"

#. +> 19 18 17 16 15 14
#: pl_exec.c:1068
#, c-format
msgid "trigger procedure cannot return a set"
msgstr "триггерная процедура не может возвращать множество"

#. +> 19 18 17 16 15 14
#: pl_exec.c:1107 pl_exec.c:1135
msgid ""
"returned row structure does not match the structure of the triggering table"
msgstr ""
"структура возвращённой строки не соответствует структуре таблицы, вызвавшей "
"триггер"

#. translator: last %s is a phrase such as "during statement block
#. local variable initialization"
#.
#. +> 19 18 17 16 15 14
