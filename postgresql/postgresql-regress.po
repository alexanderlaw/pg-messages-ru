#. +> 19
#: regress.c:207
#, c-format
msgid "invalid input syntax for type %s: \"%s\""
msgstr "неверный синтаксис для типа %s: \"%s\""

#. +> 19
#: regress.c:853
#, c-format
msgid "test_inline_in_from_support_func called with %d args but expected 3"
msgstr ""
"test_inline_in_from_support_func должна вызываться с 3 аргументами, а "
"вызвана с %d"

#. +> 19
#: regress.c:861 regress.c:877
#, c-format
msgid "test_inline_in_from_support_func called with non-Const parameters"
msgstr "test_inline_in_from_support_func вызвана не с константными параметрами"

#. +> 19
#: regress.c:868 regress.c:884
#, c-format
msgid "test_inline_in_from_support_func called with non-TEXT parameters"
msgstr "test_inline_in_from_support_func вызвана не с текстовыми параметрами"

#. +> 19
#: regress.c:917
#, c-format
msgid "test_inline_in_from_support_func parsed to more than one node"
msgstr ""
"test_inline_in_from_support_func получила при разборе более одного узла"

#. +> 19
#: regress.c:928
#, c-format
msgid "test_inline_in_from_support_func rewrote to more than one node"
msgstr ""
"test_inline_in_from_support_func получила при перезаписи более одного узла"

#. +> 19
#: regress.c:935
#, c-format
msgid "test_inline_in_from_support_func didn't parse to a Query"
msgstr "test_inline_in_from_support_func не получила Query при разборе"

#. +> 19
