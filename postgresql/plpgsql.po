#. +> 19 18 17 16 15 14
#: pl_comp.c:333 pl_handler.c:496
#, c-format
msgid "PL/pgSQL functions cannot accept type %s"
msgstr "функции PL/pgSQL не могут принимать тип %s"

#. +> 19 18 17 16 15 14
#: pl_comp.c:425
#, c-format
msgid "could not determine actual return type for polymorphic function \"%s\""
msgstr ""
"не удалось определить фактический тип результата для полиморфной функции "
"\"%s\""

#. +> 17 16 15 14
#: pl_comp.c:2528
#, c-format
msgid ""
"could not determine actual argument type for polymorphic function \"%s\""
msgstr ""
"не удалось определить фактический тип аргумента для полиморфной функции "
"\"%s\""

#. +> 19 18 17 16 15 14
#: pl_comp.c:455
#, c-format
msgid "trigger functions can only be called as triggers"
msgstr "триггерные функции могут вызываться только в триггерах"

#. +> 19 18 17 16 15 14
#: pl_comp.c:459 pl_handler.c:480
#, c-format
msgid "PL/pgSQL functions cannot return type %s"
msgstr "функции PL/pgSQL не могут возвращать тип %s"

#. +> 19 18 17 16 15 14
#: pl_comp.c:499
#, c-format
msgid "trigger functions cannot have declared arguments"
msgstr "у триггерных функций не может быть объявленных аргументов"

#. +> 19 18 17 16 15 14
#: pl_comp.c:500
#, c-format
msgid ""
"The arguments of the trigger can be accessed through TG_NARGS and TG_ARGV "
"instead."
msgstr ""
"При необходимости к аргументам триггера можно обращаться через переменные "
"TG_NARGS и TG_ARGV."

#. +> 19 18 17 16 15 14
#: pl_comp.c:633
#, c-format
msgid "event trigger functions cannot have declared arguments"
msgstr "у функций событийных триггеров не может быть объявленных аргументов"

#. +> 19 18 17 16 15 14
#: pl_comp.c:910
#, c-format
msgid "compilation of PL/pgSQL function \"%s\" near line %d"
msgstr "компиляция функции PL/pgSQL \"%s\" в районе строки %d"

#. +> 19 18 17 16 15 14
#: pl_comp.c:933
#, c-format
msgid "parameter name \"%s\" used more than once"
