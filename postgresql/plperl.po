#, c-format
msgid "%s"
msgstr "%s"

#. +> 19 18 17 16 15 14
#: plperl.c:673
#, c-format
msgid "while executing PostgreSQL::InServer::SPI::bootstrap"
msgstr "при выполнении PostgreSQL::InServer::SPI::bootstrap"

#. +> 19 18 17 16 15 14
#: plperl.c:857
#, c-format
msgid "while parsing Perl initialization"
msgstr "при разборе параметров инициализации Perl"

#. +> 19 18 17 16 15 14
#: plperl.c:863
#, c-format
msgid "while running Perl initialization"
msgstr "при выполнении инициализации Perl"

#. +> 19 18 17 16 15 14
#: plperl.c:980
#, c-format
msgid "while executing PLC_TRUSTED"
msgstr "при выполнении PLC_TRUSTED"

#. +> 19 18 17 16 15 14
#: plperl.c:992
#, c-format
msgid "while executing utf8fix"
msgstr "при выполнении utf8fix"

#. +> 19 18 17 16 15 14
#: plperl.c:1035
#, c-format
msgid "while executing plperl.on_plperl_init"
msgstr "при выполнении plperl.on_plperl_init"

#. +> 19 18 17 16 15 14
#: plperl.c:1058
#, c-format
msgid "while executing plperl.on_plperlu_init"
msgstr "при выполнении plperl.on_plperlu_init"

#. +> 19 18 17 16 15 14
#: plperl.c:1104 plperl.c:1834
#, c-format
msgid "Perl hash contains nonexistent column \"%s\""
msgstr "Perl-хеш содержит несуществующий столбец \"%s\""

#. +> 19 18 17 16 15 14
#: plperl.c:1109 plperl.c:1839
#, c-format
msgid "cannot set system attribute \"%s\""
msgstr "присвоить значение системному атрибуту \"%s\" нельзя"

#. +> 19 18 17 16 15 14
#: plperl.c:1210 plperl.c:1225 plperl.c:1242
#, c-format
msgid ""
"multidimensional arrays must have array expressions with matching dimensions"
msgstr ""
"для многомерных массивов должны задаваться выражения с соответствующими "
"размерностями"

#. +> 19 18 17
#: plperl.c:1215
#, c-format
msgid "number of array dimensions exceeds the maximum allowed (%d)"
msgstr "число размерностей массива превышает предел (%d)"

#. +> 16 15 14
#: plperl.c:1209
#, c-format
msgid "number of array dimensions (%d) exceeds the maximum allowed (%d)"
msgstr "число размерностей массива (%d) превышает предел (%d)"

#. +> 19 18 17 16 15 14
#: plperl.c:1278
#, fuzzy, c-format
#| msgid "number of array dimensions exceeds the maximum allowed (%d)"
msgid "array size exceeds the maximum allowed (%zu)"
msgstr "число размерностей массива превышает предел (%d)"

#. +> 19 18 17 16 15 14
#: plperl.c:1304
#, c-format
msgid "cannot convert Perl array to non-array type %s"
msgstr "Perl-массив нельзя преобразовать в тип не массива %s"

#. +> 19 18 17 16 15 14
#: plperl.c:1405
#, c-format
msgid "cannot convert Perl hash to non-composite type %s"
msgstr "Perl-хеш нельзя преобразовать в не составной тип %s"

#. +> 19 18 17 16 15 14
#: plperl.c:1427 plperl.c:3347
#, c-format
msgid ""
"function returning record called in context that cannot accept type record"
msgstr ""
"функция, возвращающая запись, вызвана в контексте, не допускающем этот тип"

#. +> 19 18 17 16 15 14
#: plperl.c:1488
#, c-format
msgid "lookup failed for type %s"
msgstr "найти тип %s не удалось"

#. +> 19 18 17 16 15 14
#: plperl.c:1809
#, c-format
msgid "$_TD->{new} does not exist"
msgstr "$_TD->{new} не существует"

#. +> 19 18 17 16 15 14
#: plperl.c:1813
#, c-format
msgid "$_TD->{new} is not a hash reference"
msgstr "$_TD->{new} - не ссылка на хеш"

#. +> 19 18 17 16 15 14
#: plperl.c:1846
#, c-format
msgid "cannot set generated column \"%s\""
msgstr "присвоить значение генерируемому столбцу \"%s\" нельзя"

#. +> 19 18 17 16 15 14
#: plperl.c:2057 plperl.c:2896
#, c-format
msgid "PL/Perl functions cannot return type %s"
msgstr "функции PL/Perl не могут возвращать тип %s"

#. +> 19 18 17 16 15 14
#: plperl.c:2070 plperl.c:2935
#, c-format
msgid "PL/Perl functions cannot accept type %s"
msgstr "функции PL/Perl не могут принимать тип %s"

#. +> 19 18 17 16 15 14
#: plperl.c:2187
#, c-format
msgid "didn't get a CODE reference from compiling function \"%s\""
msgstr "не удалось получить ссылку на код после компиляции функции \"%s\""

#. +> 19 18 17 16 15 14
#: plperl.c:2278
#, c-format
msgid "didn't get a return item from function"
msgstr "не удалось получить возвращаемый элемент от функции"

#. +> 19 18 17 16 15 14
#: plperl.c:2322 plperl.c:2389
#, c-format
msgid "couldn't fetch $_TD"
msgstr "не удалось получить $_TD"

#. +> 19 18 17 16 15 14
#: plperl.c:2346 plperl.c:2409
#, c-format
msgid "didn't get a return item from trigger function"
msgstr "не удалось получить возвращаемый элемент от триггерной функции"

#. +> 19 18 17 16 15 14
#: plperl.c:2466
#, c-format
msgid "set-valued function called in context that cannot accept a set"
msgstr ""
"функция, возвращающая множество, вызвана в контексте, где ему нет места"

#. +> 19 18 17 16 15
#: plperl.c:2471
#, c-format
msgid "materialize mode required, but it is not allowed in this context"
msgstr "требуется режим материализации, но он недопустим в этом контексте"

#. +> 19 18 17 16 15 14
#: plperl.c:2516
#, c-format
msgid ""
"set-returning PL/Perl function must return reference to array or use "
"return_next"
msgstr ""
"функция PL/Perl, возвращающая множество, должна возвращать ссылку на массив "
"или вызывать return_next"

#. +> 19 18 17 16 15 14
#: plperl.c:2636
#, c-format
msgid "ignoring modified row in DELETE trigger"
msgstr "в триггере DELETE изменённая строка игнорируется"

#. +> 19 18 17 16 15 14
#: plperl.c:2644
#, c-format
msgid ""
"result of PL/Perl trigger function must be undef, \"SKIP\", or \"MODIFY\""
msgstr ""
"результатом триггерной функции PL/Perl должен быть undef, \"SKIP\" или "
"\"MODIFY\""

#. +> 19 18 17 16 15 14
#: plperl.c:2891
#, c-format
msgid "trigger functions can only be called as triggers"
msgstr "триггерные функции могут вызываться только в триггерах"

#. +> 19 18 17 16 15 14
#: plperl.c:3252
#, c-format
msgid "query result has too many rows to fit in a Perl array"
msgstr ""
"результат запроса содержит слишком много строк для передачи в массиве Perl"

#. +> 19 18 17 16 15 14
#: plperl.c:3324
#, c-format
msgid "cannot use return_next in a non-SETOF function"
msgstr ""
"return_next можно использовать только в функциях, возвращающих множества"

#. +> 19 18 17 16 15 14
#: plperl.c:3398
#, c-format
msgid ""
"SETOF-composite-returning PL/Perl function must call return_next with "
"reference to hash"
msgstr ""
"функция PL/Perl, возвращающая составное множество, должна вызывать "
"return_next со ссылкой на хеш"

#. +> 19 18 17 16 15 14
#: plperl.c:4180
#, c-format
msgid "PL/Perl function \"%s\""
msgstr "функция PL/Perl \"%s\""

#. +> 19 18 17 16 15 14
#: plperl.c:4192
#, c-format
msgid "compilation of PL/Perl function \"%s\""
msgstr "компиляция функции PL/Perl \"%s\""

#. +> 19 18 17 16 15 14
#: plperl.c:4201
#, c-format
msgid "PL/Perl anonymous code block"
msgstr "анонимный блок кода PL/Perl"
