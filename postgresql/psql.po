msgstr ""
"  PGDATABASE\n"
"    синоним параметра подключения dbname\n"

#. +> 19 18 17 16 15 14
#: help.c:538
msgid ""
"  PGHOST\n"
"    same as the host connection parameter\n"
msgstr ""
"  PGHOST\n"
"    синоним параметра подключения host\n"

#. +> 19 18 17 16 15 14
#: help.c:540
msgid ""
"  PGPASSFILE\n"
"    password file name\n"
msgstr ""
"  PGPASSFILE\n"
"    имя файла с паролем\n"

#. +> 19 18 17 16 15 14
#: help.c:542
msgid ""
"  PGPASSWORD\n"
"    connection password (not recommended)\n"
msgstr ""
"  PGPASSWORD\n"
"    пароль для подключения (использовать не рекомендуется)\n"

#. +> 19 18 17 16 15 14
#: help.c:544
msgid ""
"  PGPORT\n"
"    same as the port connection parameter\n"
msgstr ""
"  PGPORT\n"
"    синоним параметра подключения port\n"

#. +> 19 18 17 16 15 14
#: help.c:546
msgid ""
"  PGUSER\n"
"    same as the user connection parameter\n"
msgstr ""
"  PGUSER\n"
"    синоним параметра подключения user\n"

#. +> 19 18 17 16 15 14
#: help.c:548
msgid ""
"  PSQL_EDITOR, EDITOR, VISUAL\n"
